{
  "name": "opencode-later",
  "version": "0.2.0",
  "description": "Global persistent Later list for OpenCode",
  "type": "module",
  "author": "ZackarySantana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZackarySantana/opencode-later.git"
  },
  "homepage": "https://github.com/ZackarySantana/opencode-later#readme",
  "bugs": {
    "url": "https://github.com/ZackarySantana/opencode-later/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "engines": {
    "opencode": "^2.1.1"
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "later",
    "tasks",
    "tui"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.1.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6 <1",
    "@opentui/solid": ">=0.6.6 <1",
    "solid-js": ">=1.9.10 <2"
  },
  "devDependencies": {
    "@opencode/theme": "2.1.1",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/bun": "latest",
    "solid-js": "1.9.15",
    "typescript": "5.8.2"
  }
}
